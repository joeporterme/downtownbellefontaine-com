[{"wp_id":4908,"title":"BPD Tailgate Party","slug":"bpd-tailgate-party","content":"<!-- wp:paragraph -->\n<p><img height=\"16\" width=\"16\" alt=\"&#x1f389;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t8c/1/16/1f389.png\"><img height=\"16\" width=\"16\" alt=\"&#x1f3c8;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/tc0/1/16/1f3c8.png\">&nbsp;BELLEFONTAINE POLICE DEPARTMENT ANNUAL TAILGATE PARTY&nbsp;<img height=\"16\" width=\"16\" alt=\"&#x1f3c8;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/tc0/1/16/1f3c8.png\"><img height=\"16\" width=\"16\" alt=\"&#x1f389;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t8c/1/16/1f389.png\"></p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Join the Bellefontaine Police Department for our Annual Tailgate Party before the Bellefontaine Chieftains football game!</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><img height=\"16\" width=\"16\" alt=\"&#x1f4c5;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t7e/1/16/1f4c5.png\">&nbsp;Friday, September 11, 2026<br><img height=\"16\" width=\"16\" alt=\"&#x23f0;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t34/1/16/23f0.png\">&nbsp;4:30 PM – 7:00 PM</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>Bring your family and friends for an evening filled with:</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p><img height=\"16\" width=\"16\" alt=\"&#x1f32d;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t7d/1/16/1f32d.png\">&nbsp;Free Food<br><img height=\"16\" width=\"16\" alt=\"&#x1f3b5;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t9e/1/16/1f3b5.png\">&nbsp;Music<br><img height=\"16\" width=\"16\" alt=\"&#x1f3af;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/tb0/1/16/1f3af.png\">&nbsp;Games<br><img height=\"16\" width=\"16\" alt=\"&#x1f3f0;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t95/1/16/1f3f0.png\">&nbsp;Inflatables<br><img height=\"16\" width=\"16\" alt=\"&#x1f693;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/te8/1/16/1f693.png\">&nbsp;Meet &amp; Talk with Police Officers<br><img height=\"16\" width=\"16\" alt=\"&#x1f381;\" src=\"https://static.xx.fbcdn.net/images/emoji.php/v9/t84/1/16/1f381.png\">&nbsp;And Much More!</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>This free community event is a great opportunity to have fun, connect with your local officers, and show your support for the Bellefontaine Chieftains as they prepare for another exciting night of football.</p>\n<!-- /wp:paragraph -->\n\n<!-- wp:paragraph -->\n<p>We look forward to seeing everyone there for food, fun, and community spirit!</p>\n<!-- /wp:paragraph -->","summary":"","start_ts":1789144200,"end_ts":1789153200,"all_day":"no","hide_end":"no","location":"","map":"","link":"https://www.facebook.com/events/1015000924800222/","link_label":"More Info","thumb":"https://downtownbellefontaine.com/wp-content/uploads/2026/06/BPD-Cookout.jpg","permalink":"https://downtownbellefontaine.com/event/bpd-tailgate-party/"}]